{
  "name": "billease-qa-automation",
  "version": "1.0.0",
  "description": "Appium tests for the BillEase mobile app on Android and iOS",
  "main": "index.js",
  "scripts": {
    "test:android": "wdio run config/wdio.android.conf.js",
    "test:android:smoke": "wdio run config/wdio.android.conf.js --mochaOpts.grep @smoke",
    "test:android:negative": "wdio run config/wdio.android.conf.js --mochaOpts.grep @negative",
    "test:android:login": "wdio run config/wdio.android.conf.js --suite login",
    "test:android:forgot": "wdio run config/wdio.android.conf.js --suite forgotPassword",
    "test:android:signup": "wdio run config/wdio.android.conf.js --suite signup",
    "test:ios": "wdio run config/wdio.ios.conf.js",
    "test:ios:smoke": "wdio run config/wdio.ios.conf.js --mochaOpts.grep @smoke"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@wdio/appium-service": "^9.33.1",
    "@wdio/cli": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "appium": "^3.9.1",
    "appium-inspector-plugin": "^2026.11.6",
    "appium-uiautomator2-driver": "^8.7.3",
    "appium-xcuitest-driver": "^12.22.8"
  }
}
